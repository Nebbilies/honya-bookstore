<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.honya.bookstore</groupId>
	<artifactId>honya-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>honya-platform</name>
	<description>Aggregator build for the Honya Bookstore microservices migration. Each module declares its own Spring Boot parent and builds independently; this POM only groups them so the whole fleet builds with one command.</description>

	<modules>
		<module>libs/honya-security-starter</module>
		<module>libs/honya-resilience-starter</module>
		<module>libs/honya-messaging-starter</module>
		<module>libs/media-events-contract</module>
		<module>libs/catalog-events-contract</module>
		<module>libs/order-events-contract</module>
		<module>libs/saga-commands-contract</module>
		<module>services/gateway</module>
		<module>services/media</module>
		<module>services/article</module>
		<module>services/review</module>
		<module>services/user</module>
		<module>services/catalog</module>
		<module>services/cart</module>
		<module>services/order</module>
		<module>services/dashboard</module>
		<module>services/checkout</module>
	</modules>

</project>
